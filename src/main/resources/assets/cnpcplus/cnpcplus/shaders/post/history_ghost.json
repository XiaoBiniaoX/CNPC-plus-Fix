{
  "type": "POST",
  "description": "Independent three-frame historical RGB ghosts and difference trails",
  "shaderResource": "cnpcplus:shaders/post/collection_screen.json",
  "remote": true,
  "defaultDuration": 300,
  "supportsLoop": true,
  "supportsMultipleInstances": true,
  "priority": 110,
  "uniforms": [
    {
      "name": "Color",
      "type": "vec3",
      "default": [
        0.5,
        0.7,
        1
      ],
      "min": 0,
      "max": 4
    },
    {
      "name": "Intensity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "Opacity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "Time",
      "type": "float",
      "default": 0
    },
    {
      "name": "Mode",
      "type": "int",
      "default": 4,
      "min": 0,
      "max": 14
    }
  ],
  "samplers": [
    {
      "name": "DiffuseSampler",
      "default": "minecraft:main"
    },
    {
      "name": "DepthSampler",
      "default": "minecraft:depth"
    },
    {
      "name": "HistorySampler",
      "default": "cnpcplus:history"
    },
    {
      "name": "HistorySampler2",
      "default": "cnpcplus:history_2"
    },
    {
      "name": "HistorySampler3",
      "default": "cnpcplus:history_3"
    }
  ]
}
