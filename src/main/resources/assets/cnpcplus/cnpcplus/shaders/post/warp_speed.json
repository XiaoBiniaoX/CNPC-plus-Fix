{
  "type": "POST",
  "description": "Twelve-sample radial scene streaks with seeded hyperspace specks",
  "shaderResource": "cnpcplus:shaders/post/collection_screen.json",
  "remote": true,
  "defaultDuration": 200,
  "supportsLoop": true,
  "supportsMultipleInstances": true,
  "priority": 110,
  "uniforms": [
    {
      "name": "Color",
      "type": "vec3",
      "default": [
        0.3,
        0.65,
        1
      ],
      "min": 0,
      "max": 4
    },
    {
      "name": "Intensity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "Opacity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "Time",
      "type": "float",
      "default": 0
    },
    {
      "name": "Mode",
      "type": "int",
      "default": 13,
      "min": 0,
      "max": 14
    }
  ],
  "samplers": [
    {
      "name": "DiffuseSampler",
      "default": "minecraft:main"
    },
    {
      "name": "DepthSampler",
      "default": "minecraft:depth"
    }
  ]
}
